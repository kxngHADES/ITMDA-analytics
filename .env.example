# Copy this file to .env and fill in the key(s) for whichever provider(s) you use.
# You only need to set the key for the provider you pass via --provider.

# Which provider to use by default when --provider isn't passed on the CLI.
# One of: groq, ollama, opencode_zen
LLM_PROVIDER=opencode_zen

# --- Groq Cloud (https://console.groq.com/keys) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (local, no key needed) ---
# Make sure `ollama serve` is running and you've pulled a model, e.g.:
#   ollama pull llama3.1
# OLLAMA_MODEL=llama3.1

# --- OpenCode Zen (https://opencode.ai/auth) ---
OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_MODEL=nemotron-3.5-lightning-free
